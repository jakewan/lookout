<!doctype html>
<html lang="en">
<head>
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'SCRIPT_HASH'; style-src 'unsafe-inline'; img-src data:; form-action 'none'; base-uri 'none'; require-trusted-types-for 'script'; trusted-types 'none'">
<meta http-equiv="x-dns-prefetch-control" content="off">
<meta name="referrer" content="no-referrer">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>lookout</title>
<style>
{{style}}</style>
</head>
<body>
<main>
<header>
  <h1>lookout &middot; <bdi>{{.Setting}}</bdi></h1>
  <time class="asof" datetime="{{.Read}}" title="read {{.Read}}, as in view.json beside this page">as of {{.AsOf}}</time>
  <span class="readage" role="status" hidden></span>
  <span class="note">a snapshot: run lookout view again, then reload, to refresh it</span>
</header>

{{if .Health}}<ul class="health">
{{- range .Health}}
  <li class="chip {{.Class}}"><bdi>{{.Input}}</bdi> {{.Label}}</li>
{{- end}}
</ul>
<ul class="faults">
{{- range .Health}}{{if .Unhealthy}}
  <li class="{{.Class}}"><strong><bdi>{{.Input}}</bdi> is {{.Label}}</strong>{{if .Reasons}}: {{range $i, $r := .Reasons}}{{if $i}}, {{end}}{{$r}}{{end}}{{end}}
    {{- if .SupplierReason}} <span class="why">&middot; supplier says: {{.SupplierReason}}</span>{{end}}
    {{- range .Details}} <span class="why">&middot; {{.}}</span>{{end}}
    {{- if .MissingFields}} <span class="why">&middot; could not fill: {{range $i, $f := .MissingFields}}{{if $i}}, {{end}}{{$f}}{{end}}</span>{{end}}
    {{- if .Excluded}} <span class="why">&middot; {{.Excluded}} records left out</span>{{end}}
    <span class="why">&middot; {{.Records}} records{{if .FetchedAt}}, read {{.FetchedAt}}{{end}}</span>
  </li>
{{- end}}{{end}}
</ul>{{end}}

{{if not .Workstreams}}<p>No workstreams{{if .Completed}} ({{.Completed}} completed){{end}}.</p>{{else}}
<section class="overview" aria-label="every workstream, in stated order">
  <div class="ovrow key"><span>{{.Active}} active within {{.Window}}</span><div class="lanekey"><span>{{.Window}} ago</span><span><span class="mark member"></span> member &middot; <span class="mark joined"></span> joined: each item's last touch</span><span>now</span></div><span>last touched</span></div>
  {{- range .Workstreams}}
  <div class="ovrow">
    <a class="ovname" href="#{{.Anchor}}">{{if .Incomplete}}<span class="bang" title="draws on a failing input">!</span>{{end}}<bdi>{{if .Title}}{{.Title}}{{else}}{{.Name}}{{end}}</bdi>{{if .Title}} <span class="wsid"><bdi>{{.Name}}</bdi></span>{{end}}</a>
    <div class="lane" role="img" aria-label="{{len .Lane}} items touched within {{$.Window}}{{if not .Unread}}, the latest {{.Idle}} ago{{end}}">
      {{- range .Lane}}
      <span class="mark {{if .Joined}}joined{{else}}member{{end}}" style="left: {{.Left}}" title="{{.Label}}"></span>
      {{- else}}
      <span class="empty">{{if .Unread}}nothing read{{else}}no touch within {{$.Window}}{{end}}</span>
      {{- end}}
    </div>
    <span class="ovstat">{{if .Unread}}<span class="badge unread">unread</span>{{else}}<span class="idle">{{.Idle}}</span> ago{{if .Stale}} <span class="badge stale">stale</span>{{end}}{{end}}{{if .Behind}} <span class="behind" title="quieter than a workstream ranked below it">&darr; behind its rank</span>{{end}}</span>
  </div>
  {{- end}}
</section>

<div class="viewswitch" role="group" aria-label="Show the detail as" hidden><button type="button" aria-pressed="true">Map</button><button type="button" aria-pressed="false">List</button></div>
<section id="map" class="map" aria-label="map" hidden>
  <nav class="crumbs" aria-label="map hub" hidden></nav>
  <div class="canvas" tabindex="-1"></div>
  <section class="panel" aria-label="selected node" hidden></section>
</section>
<div id="lists">
<h2>Workstreams</h2>
{{- end}}
{{- range .Workstreams}}
<section class="ws{{if .Incomplete}} incomplete{{end}}" id="{{.Anchor}}">
  <details>
    <summary>
      <span class="name"><bdi>{{if .Title}}{{.Title}}{{else}}{{.Name}}{{end}}</bdi></span>{{if .Title}} <span class="wsid"><bdi>{{.Name}}</bdi></span>{{end}}
      <span class="stats">{{if .Unread}}nothing read for it on this read{{else}}last touched {{.Idle}} ago{{end}}{{if ne .Age "--"}} &middot; started {{.Age}} ago{{end}} &middot; {{range $i, $g := .Groups}}{{if $i}}, {{end}}<bdi>{{$g.Input}}</bdi> {{len $g.Items}}{{else}}no members{{end}}</span>
      {{- if .Incomplete}}
      <span class="warnband">may be incomplete: draws on {{range $i, $in := .Incomplete}}{{if $i}}, {{end}}<bdi>{{$in}}</bdi>{{end}}</span>
      {{- end}}
    </summary>
    <div class="groups">
    {{- range .Groups}}
      <div class="group">
        <h3><bdi>{{.Input}}</bdi></h3>
        <ul>
        {{- range .Items}}
          <li class="{{if .Join}}join{{else if .Unread}}unread{{end}}">
            {{- if .Href}}<a href="{{.Href}}" target="_blank" rel="noreferrer noopener"><span class="id"><bdi>{{.ID}}</bdi></span></a>{{else}}<span class="id"><bdi>{{.ID}}</bdi></span>{{end}}
            {{- if .Title}} <bdi>{{.Title}}</bdi>{{end}}
            {{- if .State}} <span class="state">{{.State}}</span>{{end}}
            {{- if .Unread}} <span class="state">not read: no input supplied it</span>{{end}}
            {{- with .Join}}<br><span class="joinbadge">joined by {{.By}} &rarr; <bdi>{{.Member}}</bdi>{{if .Via}} via <bdi>{{.Via}}</bdi>{{end}}</span>{{end}}
          </li>
        {{- end}}
        </ul>
      </div>
    {{- end}}
    </div>
  </details>
</section>
{{- end}}
{{- if .Workstreams}}
</div>
{{- end}}
{{- if .UnplacedItems}}

<section class="ws unplaced" id="unplaced" aria-label="Unplaced">
  <details>
    <summary>
      <span class="name">{{len .UnplacedItems}} unplaced</span>
      <span class="stats">no live workstream holds these; newest touch first</span>
    </summary>
    <ul>
    {{- range .UnplacedItems}}
      <li>
        {{- if .Href}}<a href="{{.Href}}" target="_blank" rel="noreferrer noopener">{{template "token" .}}</a>{{else}}{{template "token" .}}{{end}}
        {{- if .Title}} <bdi>{{.Title}}</bdi>{{end}}
        {{- if .State}} <span class="state">{{.State}}</span>{{end}} <span class="state">{{if eq .Touched "--"}}last touch unreadable{{else}}{{.Touched}} ago{{end}}</span>
      </li>
    {{- end}}
    </ul>
  </details>
</section>
{{- end}}

<footer{{if .AnyUnhealthy}} class="flagged"{{end}}>
  {{if .AnyUnhealthy}}&#9650; inputs are failing, so these counts may be short: {{end}}{{len .UnplacedItems}} unplaced{{if .Dismissed}}, {{.Dismissed}} dismissed{{end}}{{if .Completed}}, {{.Completed}} workstream{{if gt .Completed 1}}s{{end}} completed{{end}}
</footer>
</main>
<script type="application/json" id="lookout-map">{{.Map}}</script>
<script type="module">{{script}}</script>
</body>
</html>
{{- define "token"}}<span class="id"{{if .ShellQuote}} title="pass it to the shell in single quotes"{{end}}><bdi>{{.Token}}</bdi></span>{{end}}
