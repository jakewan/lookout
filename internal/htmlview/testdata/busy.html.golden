, open","words":["in hub","open"],"flag":"","tone":"","state":"open","href":"","joined_by":"","hidden_chars":false,"anchor":"","parent":17,"children":[19],"weight":1,"rollup":"1 item","rollup_tone":"","start_collapsed":false},{"kind":"item","handle":"hub:owner/infra#4","ref":"hub:owner/infra#4","label":"Pin the base image","sub":"owner/infra#4","name":"Pin the base image owner/infra#4, in hub, open, joined by milestone","words":["in hub","open","joined by milestone"],"flag":"","tone":"","state":"open","href":"","joined_by":"milestone","hidden_chars":false,"anchor":"","parent":18,"children":[],"weight":1,"rollup":"","rollup_tone":"","start_collapsed":false},{"kind":"workstream","handle":"docs-site","ref":"docs-site","label":"docs-site","sub":"","name":"docs-site, stale","words":["stale"],"flag":"◷","tone":"stale","state":"","href":"","joined_by":"","hidden_chars":false,"anchor":"ws-5","parent":0,"children":[21],"weight":1,"rollup":"1 item","rollup_tone":"stale","start_collapsed":false},{"kind":"item","handle":"code:owner/docs:draft/guides","ref":"code:owner/docs:draft/guides","label":"owner/docs:draft/guides","sub":"","name":"owner/docs:draft/guides, in code, open","words":["in code","open"],"flag":"","tone":"stale","state":"open","href":"","joined_by":"","hidden_chars":false,"anchor":"","parent":20,"children":[],"weight":1,"rollup":"","rollup_tone":"","start_collapsed":false},{"kind":"workstream","handle":"onboarding","ref":"onboarding","label":"onboarding","sub":"","name":"onboarding, draws on a failing input: tracker, nothing read","words":["draws on a failing input: tracker","nothing read"],"flag":"!?","tone":"fault","state":"","href":"","joined_by":"","hidden_chars":false,"anchor":"ws-6","parent":0,"children":[23],"weight":1,"rollup":"1 item, 1 not read","rollup_tone":"unread","start_collapsed":false},{"kind":"unread","handle":"tracker:ABC-55","ref":"tracker:ABC-55","label":"ABC-55","sub":"","name":"ABC-55, in tracker, not read: no input supplied it","words":["i