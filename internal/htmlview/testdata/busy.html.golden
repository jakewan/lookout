  <li class="chip ok"><bdi>sessions</bdi> ok</li>
  <li class="chip degraded"><bdi>tracker</bdi> degraded</li>
  <li class="chip error"><bdi>chat</bdi> error</li>
</ul>
<ul class="faults">
