<!doctype html>
<html lang="en">
<head>
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'sha256-DtatE0Gd0w47kRTEiKZD8Na+7lK8XGD/TdfFHRjBCis='; style-src 'unsafe-inline'; img-src data:; form-action 'none'; base-uri 'none'; require-trusted-types-for 'script'; trusted-types 'none'">
<meta http-equiv="x-dns-prefetch-control" content="off">
<meta name="referrer" content="no-referrer">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>lookout</title>
<style>
:root {
  --bg: #fbfbfa; --panel: #ffffff; --ink: #1d1d1b; --muted: #6b6b66; --rule: #e4e3df;
  --ok: #4f7a5a; --warn: #946000; --warn-bg: #fff4dd; --bad: #b3261e; --bad-bg: #fde8e6;
  --mark: #33332f; --join: #6a5acd;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #161615; --panel: #1f1f1d; --ink: #ecebe6; --muted: #9b9a93; --rule: #34332f;
    --ok: #7fb58c; --warn: #f0b04a; --warn-bg: #3a2c10; --bad: #ff8a80; --bad-bg: #3d1a17;
    --mark: #ecebe6; --join: #a99cff;
  }
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--ink); font: 14px/1.45 system-ui, -apple-system, "Segoe UI", sans-serif; }
main { max-width: 1100px; margin: 0 auto; padding: 20px 16px 48px; }
header { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 16px; margin-bottom: 12px; }
h1 { font-size: 20px; margin: 0; }
h2 { font-size: 13px; margin: 22px 0 6px; color: var(--muted); text-transform: uppercase; letter-spacing: .05em; }
.asof { font-size: 16px; font-weight: 600; }
.note { color: var(--muted); font-size: 12px; }
.id { font-family: ui-monospace, "SF Mono", Menlo, monospace; font-size: 12px; }
a { color: inherit; }

/* Inputs: healthy ones stay grey; color is spent only on a fault. */
.health { display: flex; flex-wrap: wrap; gap: 6px; margin: 0 0 6px; padding: 0; list-style: none; }
.chip { border: 1px solid var(--rule); border-radius: 999px; padding: 2px 10px; background: var(--panel); font-size: 12px; }
.chip.ok { color: var(--muted); }
.chip.ok::before { content: "\25CF  "; color: var(--ok); }
.chip.degraded { border-color: var(--warn); background: var(--warn-bg); color: var(--warn); font-weight: 600; }
.chip.degraded::before { content: "\25B2  "; }
.chip.error, .chip.fault { border-color: var(--bad); background: var(--bad-bg); color: var(--bad); font-weight: 600; }
.chip.error::before { content: "\2716  "; }
.chip.fault { border-style: dashed; }
.chip.fault::before { content: "?  "; }
.faults { margin: 0 0 14px; padding: 0; list-style: none; font-size: 13px; }
.faults li { margin: 3px 0; padding: 4px 10px; border-left: 3px solid var(--bad); background: var(--panel); }
.faults li.degraded { border-left-color: var(--warn); }
.faults .why { color: var(--muted); }

/* Overview: every workstream as one lane on a shared time axis. */
.overview { background: var(--panel); border: 1px solid var(--rule); border-radius: 8px; padding: 8px 12px; }
.ovrow { display: grid; grid-template-columns: minmax(130px, 210px) 1fr minmax(120px, 170px); gap: 12px; align-items: center; min-height: 26px; }
.ovrow + .ovrow { border-top: 1px solid var(--rule); }
.ovrow.key { color: var(--muted); font-size: 11px; min-height: 18px; }
.ovname { font-weight: 600; text-decoration: none; overflow-wrap: anywhere; }
.ovname:hover { text-decoration: underline; }
.bang { color: var(--warn); font-weight: 800; margin-right: 4px; }
.ovstat { font-size: 12px; color: var(--muted); }
.idle { color: var(--ink); font-weight: 600; font-variant-numeric: tabular-nums; }
.behind { color: var(--warn); white-space: nowrap; }
.badge { display: inline-block; border-radius: 4px; padding: 0 6px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .03em; }
.badge.stale { background: var(--warn-bg); color: var(--warn); }
.badge.unread { border: 1px solid var(--muted); color: var(--muted); }
.lane { position: relative; height: 20px; margin: 0 6px; background: linear-gradient(var(--rule), var(--rule)) center / 100% 2px no-repeat; }
.lane .mark { position: absolute; top: 4px; margin-left: -6px; }
.lane .empty { position: absolute; left: 0; top: 1px; padding-right: 6px; background: var(--panel); color: var(--muted); font-size: 11px; }
.mark { display: inline-block; width: 12px; height: 12px; border-radius: 50%; vertical-align: -1px; }
.mark.member { background: var(--mark); }
.mark.joined { border: 2px solid var(--join); background: var(--panel); }
.lanekey { display: flex; justify-content: space-between; gap: 8px; margin: 0 6px; }

/* Detail on demand: one collapsed section per workstream. */
.ws { background: var(--panel); border: 1px solid var(--rule); border-radius: 8px; margin: 6px 0; padding: 6px 12px; }
.ws.incomplete { border-color: var(--warn); }
.ws:target { outline: 2px solid var(--join); }
summary { cursor: pointer; }
.name { font-weight: 600; }
/* The id commands take, beside a title, quieter than the label it names. */
.wsid { font-family: ui-monospace, monospace; font-size: 11px; font-weight: 400; color: var(--muted); }
.stats { color: var(--muted); font-size: 12px; margin-left: 8px; }
.warnband { display: inline-block; margin-left: 8px; padding: 0 8px; border-radius: 4px; background: var(--warn-bg); color: var(--warn); font-size: 12px; }
.groups { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 8px 16px; margin: 8px 0 4px; }
.group h3 { margin: 0 0 2px; font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: .04em; }
.group ul { margin: 0; padding: 0; list-style: none; }
.group li { padding: 2px 0; border-top: 1px dashed var(--rule); }
.group li.join { padding-left: 10px; border-left: 2px solid var(--join); }
.group li.unread { color: var(--muted); font-style: italic; }
.joinbadge { color: var(--join); font-size: 11px; font-weight: 600; }
/* What no workstream holds sits below them all, in the map's view and the
   lists' alike, so it reads as one more group rather than part of either. */
.unplaced { margin-top: 14px; }
.unplaced ul { margin: 8px 0 4px; padding: 0; list-style: none; }
.unplaced li { padding: 2px 0; border-top: 1px dashed var(--rule); }
/* A token is what a command takes, so its spaces show as written, not
   collapsed into one. */
.unplaced .id { white-space: pre-wrap; }
.state { color: var(--muted); font-size: 11px; }

/* The map, drawn as a hand-drawn mind map is: branches leave the center to
   both sides, thinning outward, each label written on its line. Branches are
   neutral; a workstream's cue sets its whole branch's tone, by what the cue
   asks of the reader: a failing input in the error color, behind its rank in
   the warning color, nothing read dashed, stale faded. Each tone also carries
   its mark and its words. A cross-link stays faint until one of its ends is
   selected. */
/* biome-ignore lint/complexity/noImportantStyles: no other rule may show what the page hides, or a failed script could show the map and the lists at once. */
[hidden] { display: none !important; }
.read { font-size: 11px; }
.viewswitch { margin: 14px 0 6px; display: flex; gap: 4px; }
.viewswitch button, .panel button, .crumbs button { font: inherit; font-size: 12px; padding: 2px 10px; border: 1px solid var(--rule); border-radius: 4px; background: var(--panel); color: var(--ink); cursor: pointer; }
.viewswitch button[aria-pressed="true"] { border-color: var(--ink); font-weight: 600; }
.map { background: var(--panel); border: 1px solid var(--rule); border-radius: 8px; padding: 8px 12px; }
.crumbs { display: flex; flex-wrap: wrap; gap: 4px; margin-bottom: 6px; }
.crumbs button::after { content: " \2192"; color: var(--muted); }
.canvas { overflow: auto; }
.plane { position: relative; margin: 0 auto; }
.plane svg { position: absolute; left: 0; top: 0; }
.plane ul { list-style: none; margin: 0; padding: 0; }
/* The tree covers the plane, so the nodes placed in it share the drawing's
   coordinates and the tree has the drawing's size. */
.plane > [role="tree"] { position: absolute; inset: 0; }
.branch { fill: none; stroke: var(--muted); stroke-linecap: round; stroke-width: 1.5; }
.branch.depth-1 { stroke-width: 5; }
.branch.depth-2 { stroke-width: 2.5; }
.branch.tone-stale { opacity: .4; }
.branch.depth-1.tone-stale { stroke-width: 3; }
.branch.tone-behind { stroke: var(--warn); }
.branch.tone-fault { stroke: var(--bad); }
.branch.tone-unread { stroke-dasharray: 6 4; }
.xlink { fill: none; stroke: var(--join); stroke-width: 1.5; stroke-dasharray: 5 4; opacity: .35; }
.xlink.strong { opacity: 1; stroke-width: 2.5; }
.xlabel { fill: var(--muted); font-size: 10px; text-anchor: middle; }
[role="treeitem"] { position: absolute; width: 0; height: 0; }
[role="treeitem"]:focus { outline: none; }
.node { position: absolute; bottom: 1px; display: flex; align-items: baseline; gap: 4px; padding: 0 3px; border: 1px solid transparent; border-radius: 4px; font-size: 12px; line-height: 1.25; white-space: nowrap; overflow: hidden; cursor: pointer; }
/* The label and id give way to an ellipsis first, so the mark and what a
   collapsed node holds stay in view however long the label. */
.node .label, .node .sub { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
.node .sub { flex-shrink: 2; }
.node .flag, .node .rollup { flex: none; }
.node.right { left: 0; }
.node.left { right: 0; text-align: right; }
.node.hub { left: 0; top: 0; bottom: auto; transform: translate(-50%, -50%); padding: 6px 16px; border: 2px solid var(--ink); border-radius: 999px; background: var(--panel); font-size: 15px; font-weight: 700; }
.node.workstream { font-size: 14px; font-weight: 600; }
.node.unread { color: var(--muted); font-style: italic; }
.node.tone-stale { color: var(--muted); }
.node.workstream.tone-behind { color: var(--warn); }
.node.workstream.tone-fault { color: var(--bad); border-color: var(--bad); }
.node .flag { font-weight: 800; }
.node .sub { font-family: ui-monospace, monospace; font-size: 10px; font-weight: 400; color: var(--muted); }
.node .rollup { font-weight: 400; color: var(--muted); }
.node .rollup.tone-behind { color: var(--warn); font-weight: 600; }
.node .rollup.tone-fault { color: var(--bad); font-weight: 600; }
.node.selected, [role="treeitem"]:focus > .node { outline: 2px solid var(--join); outline-offset: 1px; }
.panel { margin-top: 8px; border-top: 1px solid var(--rule); padding-top: 6px; font-size: 13px; }
.panel h2 { margin: 0; font-size: 14px; color: var(--ink); text-transform: none; letter-spacing: 0; }
.vh { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
.panel p { margin: 4px 0; }
.panel ul { margin: 4px 0; padding-left: 18px; }

footer { margin-top: 16px; font-size: 13px; }
footer.flagged { color: var(--warn); font-weight: 600; }
@media (max-width: 640px) {
  .ovrow { grid-template-columns: 1fr; gap: 2px; padding: 4px 0; }
}
</style>
</head>
<body>
<main>
<header>
